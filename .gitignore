# --- Build output -------------------------------------------------------------
# These are the important ones: FocusFlow.App/bin alone is ~2.6 GB and contains
# SkiaSharp PDBs well over GitHub's 100 MB per-file hard limit.
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

