# --- FocusFlow runtime data ---------------------------------------------------
# The app writes these under %APPDATA%/~/.config, so they should never appear in
# the repo — but ignore them anyway in case anyone points the data directory at
# the working tree while debugging.
config.json
session.json
history.jsonl
*.jsonl.tmp
*.json.tmp
