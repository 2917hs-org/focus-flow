<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FocusFlow.App.ViewModels"
        x:Class="FocusFlow.App.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="FocusFlow"
        Icon="/Assets/app-icon.png"
        Width="420"
        SizeToContent="Height"
        MinWidth="400"
        MinHeight="200"
        Background="{DynamicResource PaletteBackground}"
        Foreground="{DynamicResource PaletteText}">

    <Window.Styles>
        <!-- Sized so the widest combination — Start, Break, Resume, Skip, Reset, Stop —
             still fits one line inside MinWidth. -->
        <Style Selector="StackPanel#Transport > Button">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Every settings group below is one of these: a Surface-coloured card rather
             than a bare heading + a Separator rule. A flat, continuous stream of every
             setting at the same visual weight made the whole pane read as one wall of
             controls; a card per group turns that into something scannable, and gives the
             new palette's Surface/Border roles an actual job now that they aren't only
             backing the mini timer widget. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PaletteSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PaletteBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Each card's "More … options" Expander is the progressive-disclosure half of
             the same idea: duration/alarm/volume are what get touched every session, so
             they stay visible; auto-start, infinite mode, session count and the reminder
             lead time are set once and rarely revisited, so they start collapsed instead
             of competing for attention with what's actually used often. Left at Fluent's
             own default template rather than reaching into its internal parts — the
             corner-radius and Slider-height fixes elsewhere in this session both came
             from guessing at Fluent's internals and needing a second pass to get right,
             and a plain Margin here gets the same "give it some breathing room" result
             without that risk. -->
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Styles>

    <StackPanel x:Name="Root" Margin="24" Spacing="16">

        <!-- Countdown, with the history icon tucked in the top-right corner rather than a
             labelled button of its own — same glyph the tray menu already uses for the
             same action, so it doesn't introduce a new visual vocabulary. -->
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="46"
                           FontWeight="Light"
                           Foreground="{Binding ModeBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource PaletteSecondary}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Button Content="▤" Command="{Binding ShowHistoryCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="6,2" FontSize="14"
                    ToolTip.Tip="View History" />
        </Grid>

        <TextBlock Text="{Binding TodaySummary}"
                   Foreground="{DynamicResource PaletteSecondary}"
                   HorizontalAlignment="Center" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center" />

        <!-- Captured into the history record when Start is pressed; see
             MainWindowViewModel.Start. Free text, no managed tag list. -->
        <TextBox Text="{Binding SessionLabel}"
                 PlaceholderText="Label this session (optional)"
                 HorizontalAlignment="Stretch" />

        <!-- Transport -->
        <StackPanel x:Name="Transport" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="6">
            <Button Content="Start" Classes="success" Command="{Binding StartCommand}"
                    ToolTip.Tip="{Binding StartPauseHotkeyTooltip}" />
            <Button Content="Break" Classes="info" Command="{Binding StartBreakCommand}" />
            <Button Content="Pause" Classes="warning" Command="{Binding PauseCommand}"
                    IsVisible="{Binding CanPauseNow}"
                    ToolTip.Tip="{Binding StartPauseHotkeyTooltip}" />
            <Button Content="Resume" Classes="success" Command="{Binding ResumeCommand}"
                    IsVisible="{Binding IsPausedNow}"
                    ToolTip.Tip="{Binding StartPauseHotkeyTooltip}" />
            <Button Content="Skip" Command="{Binding SkipCommand}"
                    ToolTip.Tip="{Binding SkipHotkeyTooltip}" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />
            <Button Content="Stop" Classes="danger" Command="{Binding StopCommand}"
                    ToolTip.Tip="{Binding StopHotkeyTooltip}" />
        </StackPanel>

        <!-- Sessions card -->
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Sessions" FontWeight="SemiBold" />

                <!-- Paired on one row: two full-width spinners stacked took far more
                     vertical space than two numbers warrant. Editable combo boxes rather
                     than NumericUpDown: a dropdown of common lengths for the one-click
                     case, but still a plain text box underneath for any other value up to
                     the cap. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Focus (min, up to 120)" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding FocusDurationPresets}"
                                  Text="{Binding StudyDuration, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Break (min, up to 60)" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding BreakDurationPresets}"
                                  Text="{Binding BreakDuration, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <Expander Header="More session options">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto"
                              RowSpacing="6">
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Auto-start breaks"
                                      IsChecked="{Binding AutoStartBreak, Mode=TwoWay}" />
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Auto-start focus"
                                      IsChecked="{Binding AutoStartStudy, Mode=TwoWay}" />
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Infinite mode"
                                      IsChecked="{Binding InfiniteMode, Mode=TwoWay}" />
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Remind before end"
                                      IsChecked="{Binding ReminderEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        IsEnabled="{Binding IsSessionCountEnabled}">
                                <TextBlock Text="Sessions per run" />
                                <NumericUpDown Value="{Binding SessionCount, Mode=TwoWay}"
                                               Minimum="1" Maximum="10" Increment="1" FormatString="0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"
                                        IsEnabled="{Binding ReminderEnabled}">
                                <TextBlock Text="Remind before (min)" />
                                <NumericUpDown Value="{Binding ReminderLeadMinutes, Mode=TwoWay}"
                                               Minimum="1" Maximum="10" Increment="1" FormatString="0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Pauses an active, unpaused session after this much idle time and
                             stays paused — it never auto-resumes, since activity returning
                             isn't proof the user is back to focusing. See IIdleTimeProvider. -->
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" Content="Auto-pause when idle after"
                                      IsChecked="{Binding IdleAutoPauseEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding IdleAutoPauseMinutePresets}"
                                      Text="{Binding IdleAutoPauseMinutes, Mode=TwoWay}"
                                      IsEnabled="{Binding IdleAutoPauseEnabled}"
                                      Width="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource PaletteSecondary}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Sound card -->
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Sound" FontWeight="SemiBold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Alarm sound" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailableSounds}"
                                  SelectedItem="{Binding SelectedSound, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseAlarmCommand}" />
                        <Button Grid.Column="2" Content="Test" Command="{Binding TestSoundCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding AlarmVolume, StringFormat='Volume: {0}%'}" />
                    <!-- Fluent reserves ~50px of vertical space for a horizontal Slider
                         regardless of Padding/MinHeight, most of it empty padding around
                         the thumb rather than anything visible. Constraining Height to
                         crop that padding was tried first and reverted: a headless
                         Avalonia probe showed the thumb's own *layout* bounds fitting
                         inside a shorter box, but the probe measures logical layout, not
                         render-time clipping — in the real app the thumb's circle was
                         visibly cut off by exactly that Height constraint. A negative
                         Margin is a different, safer mechanism: it repositions the whole
                         already-correctly-rendered control rather than resizing it, so
                         nothing about the Slider's own internal template rendering is
                         touched, which is what actually caused the clipping. -->
                    <Slider Value="{Binding AlarmVolume, Mode=TwoWay}"
                            Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,-14,0,-14" />
                </StackPanel>

                <Expander Header="More sound options">
                    <StackPanel Spacing="12">
                        <CheckBox Content="Play music when a break ends"
                                  IsChecked="{Binding PlayMusicAfterBreak, Mode=TwoWay}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding MusicPath}"
                                     PlaceholderText="No music selected" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseMusicCommand}" />
                            <Button Grid.Column="2" Content="Stop" Command="{Binding StopAudioCommand}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Application card. No "More options" Expander here — Theme and Launch at
             login are the whole card, so there's nothing left to collapse. -->
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Application" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Theme" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Launch at login"
                              VerticalAlignment="Bottom"
                              IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}"
                              IsEnabled="{Binding IsStartupSupported}" />
                </Grid>
                <TextBlock Text="{Binding StartupWarning}"
                           IsVisible="{Binding StartupWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource PaletteSecondary}"
                           FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Hotkeys card. Combinations work even while FocusFlow isn't focused — see
             IGlobalHotkeys. Click a row's button to capture a new combination; Esc cancels.
             The checkbox turns that action's hotkey off without forgetting the combination,
             so turning it back on later remembers what was set before. Set-once-and-forget
             like the other cards' "More … options" content, so the rows themselves live in
             an Expander rather than sitting open by default. -->
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Hotkeys" FontWeight="SemiBold" />
                <TextBlock Text="Work even while FocusFlow isn't the focused app."
                           Foreground="{DynamicResource PaletteSecondary}"
                           FontSize="11" TextWrapping="Wrap" />

                <Expander Header="More hotkey options">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="8" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start / Pause" VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1" Content="{Binding StartPauseHotkeyDisplay}"
                                    Command="{Binding BeginCaptureStartPauseHotkeyCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            <CheckBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="{Binding StartPauseHotkeyEnabled, Mode=TwoWay}" />
                            <Button Grid.Row="0" Grid.Column="3" Content="Reset" FontSize="10" Padding="6,2"
                                    Command="{Binding ResetStartPauseHotkeyCommand}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stop" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Content="{Binding StopHotkeyDisplay}"
                                    Command="{Binding BeginCaptureStopHotkeyCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            <CheckBox Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="{Binding StopHotkeyEnabled, Mode=TwoWay}" />
                            <Button Grid.Row="1" Grid.Column="3" Content="Reset" FontSize="10" Padding="6,2"
                                    Command="{Binding ResetStopHotkeyCommand}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Skip" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1" Content="{Binding SkipHotkeyDisplay}"
                                    Command="{Binding BeginCaptureSkipHotkeyCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="{Binding SkipHotkeyEnabled, Mode=TwoWay}" />
                            <Button Grid.Row="2" Grid.Column="3" Content="Reset" FontSize="10" Padding="6,2"
                                    Command="{Binding ResetSkipHotkeyCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding HotkeyWarning}"
                                   IsVisible="{Binding HotkeyWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{DynamicResource PaletteSecondary}"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- App Blocking card. macOS only — see MacAppBlockingMonitor/NoopAppBlockingMonitor.
             Management itself (the list, the picker) lives in its own window — see
             BlockedAppsWindow — this card is just the entry point and the permission status,
             the same split MainWindow already uses for session history. -->
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="App Blocking" FontWeight="SemiBold" />
                <TextBlock Text="Hide these apps and bring FocusFlow forward if you switch to them during a focus session."
                           Foreground="{DynamicResource PaletteSecondary}"
                           FontSize="11" TextWrapping="Wrap" />

                <Button Content="{Binding ManageBlockedAppsLabel}" Classes="info" HorizontalAlignment="Stretch"
                        Command="{Binding ManageBlockedAppsCommand}" />

                <StackPanel Spacing="6" IsVisible="{Binding IsAppBlockingSupported, Converter={x:Static BoolConverters.Not}}">
                    <TextBlock Text="{Binding AppBlockingWarning}"
                               Foreground="{DynamicResource PaletteSecondary}"
                               FontSize="11" TextWrapping="Wrap" />
                    <Button Content="Open Accessibility Settings" Classes="info"
                            Command="{Binding RequestAccessibilityCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Closing this window keeps FocusFlow running in the tray."
                   Foreground="{DynamicResource PaletteSecondary}"
                   FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</Window>
