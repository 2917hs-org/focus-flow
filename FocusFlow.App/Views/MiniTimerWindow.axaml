<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FocusFlow.App.ViewModels"
        x:Class="FocusFlow.App.Views.MiniTimerWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="FocusFlow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <!-- Local to the widget rather than the shared success/warning/danger classes in
             App.axaml: those size for MainWindow's full-height buttons, this widget needs
             its own compact Padding/FontSize. Both draw from the same DynamicResource
             palette keys, though, so the colours themselves stay in sync with the rest of
             the app and with the current platform/theme. Fluent restyles the inner
             ContentPresenter on hover/press, so each state needs its own setter or the
             theme colour would show through on interaction. -->
        <Style Selector="Button.mini-resume">
            <Setter Property="Background" Value="{DynamicResource PaletteSuccess}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.mini-resume:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteSuccessHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.mini-resume:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteSuccessPressed}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.mini-pause">
            <Setter Property="Background" Value="{DynamicResource PaletteWarning}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.mini-pause:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteWarningHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.mini-pause:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteWarningPressed}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.mini-stop">
            <Setter Property="Background" Value="{DynamicResource PaletteError}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.mini-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteErrorHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.mini-stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteErrorPressed}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <!-- Its own rounded surface rather than the window chrome: WindowDecorations="None"
         gives a transparent, borderless window, so the widget has to paint its own
         background to read as a floating card instead of stray controls on the desktop.
         PaletteSurface rather than a fixed colour: a fixed background is exactly what left
         the earlier hardcoded black StatusText illegible the moment the OS switched to
         dark mode, since nothing else adapted with it. Surface + Text both come from the
         same palette now, so they can't drift out of sync with each other again. -->
    <Border Background="{DynamicResource PaletteSurface}"
            CornerRadius="12"
            Padding="12,9"
            BoxShadow="0 6 20 0 #40000000">
        <StackPanel Width="150" Spacing="7">

            <!-- Only this area drags the window — the transport row below needs its
                 clicks to reach the buttons, not to start a drag. -->
            <StackPanel x:Name="DragHandle" Spacing="1" Background="Transparent"
                        PointerPressed="OnDragHandlePointerPressed">
                <TextBlock Text="{Binding CurrentTime}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           FontFamily="Menlo, Consolas, monospace"
                           Foreground="{Binding ModeBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="10"
                           Foreground="{DynamicResource PaletteSecondary}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ProgressBar Value="{Binding SessionProgress}"
                         Minimum="0" Maximum="1"
                         Height="3"
                         Foreground="{Binding ModeBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <Button Content="Pause" Classes="mini-pause" Padding="8,3" FontSize="11"
                        Command="{Binding PauseCommand}"
                        IsVisible="{Binding CanPauseNow}"
                        ToolTip.Tip="{Binding StartPauseHotkeyTooltip}" />
                <Button Content="Resume" Classes="mini-resume" Padding="8,3" FontSize="11"
                        Command="{Binding ResumeCommand}"
                        IsVisible="{Binding IsPausedNow}"
                        ToolTip.Tip="{Binding StartPauseHotkeyTooltip}" />
                <Button Content="Stop" Classes="mini-stop" Padding="8,3" FontSize="11"
                        Command="{Binding StopCommand}"
                        ToolTip.Tip="{Binding StopHotkeyTooltip}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
