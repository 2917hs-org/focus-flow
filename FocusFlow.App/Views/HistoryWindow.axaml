<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FocusFlow.App.ViewModels"
        xmlns:views="using:FocusFlow.App.Views"
        x:Class="FocusFlow.App.Views.HistoryWindow"
        x:DataType="viewModels:HistoryViewModel"
        Title="FocusFlow — History"
        Icon="/Assets/app-icon.png"
        Width="600"
        Height="560"
        CanResize="False"
        Background="{DynamicResource PaletteBackground}"
        Foreground="{DynamicResource PaletteText}">

    <!-- A genuinely separate window from MainWindow — not embedded content — but same
         dimensions as it, and with a Back button that hides this window and brings
         MainWindow forward (see HistoryWindow.axaml.cs's BackRequested), so switching
         between them reads as staying inside one app rather than juggling two windows of
         different shapes. -->
    <Window.Styles>
        <!-- Same secondary Button look MainWindow/BlockedAppsWindow use, since this window
             doesn't share styles across window boundaries. -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource PaletteSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource PaletteText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PaletteBorder}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PaletteText}" />
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PaletteBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource PaletteText}" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="‹ Back" Classes="secondary" Click="OnBackClick" />
                <TextBlock Text="Session History" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- DataContext flows down from this Window's own — set by App.axaml.cs to the
                 shared HistoryViewModel singleton. -->
            <views:HistoryView />
        </StackPanel>
    </ScrollViewer>
</Window>
