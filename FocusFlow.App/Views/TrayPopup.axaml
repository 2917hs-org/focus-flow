<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FocusFlow.App.ViewModels"
        x:Class="FocusFlow.App.Views.TrayPopup"
        x:DataType="viewModels:MainWindowViewModel"
        Title="FocusFlow"
        Width="260"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        Topmost="True">
    <StackPanel Margin="16" Spacing="12">

        <StackPanel Spacing="2">
            <TextBlock Text="{Binding CurrentTime}" FontSize="34" FontWeight="Light"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>

        <ProgressBar Value="{Binding SessionProgress}" Minimum="0" Maximum="1" Height="4" />

        <WrapPanel HorizontalAlignment="Center" ItemSpacing="6" LineSpacing="6">
            <Button Content="Start" Command="{Binding StartCommand}" />
            <!-- Pause is intentionally absent during study; it only appears on a break. -->
            <Button Content="Pause" Command="{Binding PauseCommand}"
                    IsVisible="{Binding CanPauseNow}" />
            <Button Content="Resume" Command="{Binding ResumeCommand}"
                    IsVisible="{Binding IsPausedNow}" />
            <Button Content="Skip" Command="{Binding SkipCommand}" />
            <Button Content="Stop" Command="{Binding StopCommand}" />
        </WrapPanel>

        <TextBlock Text="{Binding TodaySummary}" FontSize="10" Opacity="0.6"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

        <Separator />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button x:Name="OpenButton" Content="Open" />
            <Button x:Name="ExitButton" Content="Exit" />
        </StackPanel>
    </StackPanel>
</Window>
